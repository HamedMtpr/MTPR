{
  "LocalTokenService": {
    "Issuer": "https://localhost:5443",
    "Audience": "mtpr-api",
    "SigningKeyPath": "keys/signing-key.pem",
    "TokenLifetimeMinutes": 60,
    "Clients": {
      "reader-client": {
        "Secret": "reader-secret-change-me",
        "Subject": "reader-user",
        "Roles": [ "reader" ]
      },
      "editor-client": {
        "Secret": "editor-secret-change-me",
        "Subject": "editor-user",
        "Roles": [ "editor" ]
      }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*"
}
