{
  "name": "order",
  "fields": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 100
    },
    {
      "name": "price",
      "type": "decimal",
      "required": true,
      "min": 0
    },
    {
      "name": "quantity",
      "type": "int",
      "required": true,
      "default": 1,
      "min": 1
    },
    {
      "name": "status",
      "type": "string",
      "required": true
    },
    {
      "name": "total",
      "type": "decimal",
      "required": true,
      "computed": {
        "operator": "multiply",
        "left": { "field": "price" },
        "right": { "field": "quantity" }
      }
    }
  ],
  "lifecycle": {
    "field": "status",
    "initial": "draft",
    "states": [ "draft", "submitted", "complete" ],
    "transitions": [
      {
        "from": "draft",
        "to": "submitted"
      },
      {
        "from": "submitted",
        "to": "complete"
      }
    ]
  },
  "rules": [
    {
      "trigger": "beforeUpdate",
      "condition": {
        "operator": "greaterThan",
        "left": { "field": "total" },
        "right": { "value": 50 }
      },
      "action": {
        "type": "reject",
        "message": "Order total exceeds 50"
      }
    }
  ]
}
