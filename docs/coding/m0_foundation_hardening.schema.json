{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtpr.dev/schemas/v0/m0_foundation_hardening.schema.json",
  "title": "M0 - Foundation Hardening",
  "$ref": "#/$defs/entity",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operator", "conditions"],
          "properties": {
            "operator": { "enum": ["and", "or"] },
            "conditions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/condition" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operator", "left", "right"],
          "properties": {
            "operator": { "enum": ["equal", "notEqual", "greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual"] },
            "left": {
              "type": "object", "required": ["field"],
              "properties": { "field": { "$ref": "#/$defs/identifier" } }, "additionalProperties": false
            },
            "right": {
              "type": "object", "required": ["value"],
              "properties": { "value": { "type": ["string", "number", "boolean", "null"] } }, "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "entity"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/identifier"
        },
        "onDelete": {
          "enum": [
            "restrict",
            "cascade",
            "setNull"
          ],
          "default": "restrict"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier",
          "not": {
            "pattern": "^[iI][dD]$"
          }
        },
        "type": {
          "enum": [
            "string",
            "int",
            "long",
            "decimal",
            "double",
            "bool",
            "dateTime",
            "guid"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "references": {
          "$ref": "#/$defs/relation"
        },
        "default": {
          "type": ["string", "number", "boolean"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "references"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "guid"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "minLength"
                ]
              },
              {
                "required": [
                  "maxLength"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "long",
                  "decimal",
                  "double"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["trigger", "condition", "action"],
            "properties": {
              "trigger": { "enum": ["beforeCreate", "afterCreate", "beforeUpdate", "afterUpdate", "beforeDelete", "afterDelete"] },
              "condition": { "$ref": "#/$defs/condition" },
              "action": {
                "type": "object",
                "required": ["type", "message"],
                "properties": {
                  "type": { "const": "reject" },
                  "message": { "type": "string", "minLength": 1, "maxLength": 500 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },        "unique": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "permissions"
      ],
      "properties": {
        "kind": {
          "const": "role"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "entity",
              "operations"
            ],
            "properties": {
              "entity": {
                "$ref": "#/$defs/identifier"
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "create",
                    "read",
                    "update",
                    "delete"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "entity",
        "trigger",
        "condition",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "rule"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "entity": {
          "$ref": "#/$defs/identifier"
        },
        "trigger": {
          "enum": [
            "beforeCreate",
            "afterCreate",
            "beforeUpdate",
            "afterUpdate",
            "beforeDelete",
            "afterDelete"
          ]
        },
        "condition": {
          "type": "object",
          "description": "Expression format to be selected in M3."
        },
        "action": {
          "type": "object",
          "description": "Action format to be selected in M3."
        }
      },
      "additionalProperties": false
    }
  }
}
